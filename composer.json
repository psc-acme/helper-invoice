{
    "name": "psc-acme/helper-invoice",
    "description": "Package helper-invoice for psc-acme organization",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Philipp Scheit",
            "email": "p.scheit@packagist.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "PscAcme\\HelperInvoice\\": "src/"
        }
    },
    "require": {
        "php": ">=8.2",
        "illuminate/support": "^11.0",
        "league/csv": "^9.0",
        "symfony/yaml": "^7.0",
        "aws/aws-sdk-php": "^3.332",
        "nette/utils": "^4.0",
        "psc-acme/handler-invoice": "^1.0",
        "psc-acme/extension-billing": "^1.0"
    },
    "require-dev": {
        "infection/infection": "^0.27",
        "behat/behat": "^3.14",
        "webforge/object-asserter": "^2.0.0"
    },
    "minimum-stability": "dev",
    "config": {
        "secure-http": false
    },
    "repositories": {
        "private-packagist": {
            "type": "composer",
            "url": "http://repo.packagist.com.lo/psc-acme/"
        },
        "packagist.org": false
    }
}